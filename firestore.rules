rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ganti EMAIL_ANDA dengan email login Anda
    function owner() {
      return request.auth != null
        && request.auth.token.email == "EMAIL_ANDA@gmail.com";
    }
    // chats/{chat}/messages/{pesan}/chunks/{potongan} ikut tercakup
    match /chats/{chatId} {
      allow read, write: if owner();
    }
    match /chats/{chatId}/{document=**} {
      allow read, write: if owner();
    }
  }
}
